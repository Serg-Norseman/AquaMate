<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RootNamespace>AquaMate</RootNamespace>
        <OutputType>Library</OutputType>
        <TargetFramework>net8.0-windows</TargetFramework>
        <UseWindowsForms>true</UseWindowsForms>
        <DefineConstants>NETCORE</DefineConstants>

        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="BSLib">
            <HintPath>..\libs\BSLib.dll</HintPath>
        </Reference>
        <Reference Include="BSLib.DataViz.Model">
            <HintPath>..\libs\BSLib.DataViz.Model.dll</HintPath>
        </Reference>
        <Reference Include="BSLib.Design">
            <HintPath>..\libs\BSLib.Design.dll</HintPath>
        </Reference>
        <Reference Include="RtfWriter">
            <HintPath>..\libs\RtfWriter.dll</HintPath>
        </Reference>
        <Reference Include="ExcelLibrary">
            <HintPath>..\libs\ExcelLibrary.dll</HintPath>
        </Reference>
        <Reference Include="ZLMKit">
            <HintPath>..\libs\ZLMKit.dll</HintPath>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
        <PackageReference Include="log4net" Version="3.5.0" />
    </ItemGroup>

</Project>
